{
  "name": "visioniq",
  "productName": "VisionIQ",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered image recognition desktop app",
  "author": "VisionIQ",
  "scripts": {
    "dev":               "vite",
    "build":             "node ./node_modules/vite/bin/vite.js build",
    "preview":           "node ./node_modules/vite/bin/vite.js preview",

    "electron:dev":      "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron ../electron/main.js\"",
    "electron:build":    "npm run build && electron-builder --config ../electron/electron-builder.yml",
    "electron:pack":     "electron-builder --dir --config ../electron/electron-builder.yml"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "react":         "^18.3.1",
    "react-dom":     "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer":         "^10.4.19",
    "postcss":              "^8.4.38",
    "tailwindcss":          "^3.4.4",
    "vite":                 "^6.3.5",

    "electron":             "^31.3.1",
    "electron-builder":     "^24.13.3",
    "concurrently":         "^8.2.2",
    "cross-env":            "^7.0.3",
    "wait-on":              "^7.2.0"
  }
}
