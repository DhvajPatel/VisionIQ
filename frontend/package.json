{
  "name": "visioniq",
  "productName": "VisionIQ",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered image recognition desktop app",
  "author": "VisionIQ",
  "main": "main.js",
  "scripts": {
    "dev":            "vite",
    "build":          "node ./node_modules/vite/bin/vite.js build",
    "preview":        "node ./node_modules/vite/bin/vite.js preview",
    "electron:dev":   "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron ../electron/main.js\"",
    "electron:build": "npm run build && electron-builder",
    "electron:pack":  "electron-builder --dir"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "react":         "^18.3.1",
    "react-dom":     "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer":         "^10.4.19",
    "concurrently":         "^8.2.2",
    "electron":             "^44.1.1",
    "electron-builder":     "^26.15.3",
    "postcss":              "^8.4.38",
    "tailwindcss":          "^3.4.4",
    "vite":                 "^6.3.5",
    "wait-on":              "^7.2.0"
  },
  "build": {
    "appId":       "com.visioniq.app",
    "productName": "VisionIQ",
    "copyright":   "© 2025 VisionIQ",
    "directories": {
      "buildResources": "../electron/assets",
      "output":         "../dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "dist/**/*",
      "public/icon.ico"
    ],
    "extraResources": [
      {
        "from":   "../backend/dist/visioniq_server",
        "to":     "backend",
        "filter": ["**/*"]
      },
      {
        "from":   "dist",
        "to":     "frontend/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "../frontend/public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon":       "../frontend/public/icon.ico",
      "uninstallerIcon":     "../frontend/public/icon.ico",
      "installerHeaderIcon": "../frontend/public/icon.ico",
      "createDesktopShortcut":    true,
      "createStartMenuShortcut":  true,
      "shortcutName":             "VisionIQ",
      "license":                  "../LICENSE.txt",
      "runAfterFinish":           true
    }
  }
}
