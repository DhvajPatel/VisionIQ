{
  "rootDirectory": "frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && chmod -R +x node_modules/.bin",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "REPLACE_WITH_YOUR_RENDER_BACKEND_URL/api/:path*" }
  ]
}
